server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Il browser parla solo con questo indirizzo: le chiamate /api vanno al back-end.
    # config.js con back-end vuoto = stesso indirizzo della pagina.
    location = /config.js {
        default_type text/javascript;
        return 200 'window.CONFIG = {"backend": ""};\n';
    }

    location /api/ {
        proxy_pass ${BACKEND_INTERNO_URL};
        proxy_set_header Host $host;
        # Con un modello locale una risposta può richiedere alcuni minuti: un margine sopra i 600 s
        # del back-end, così l'errore di timeout arriva dal back-end con un messaggio leggibile.
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
