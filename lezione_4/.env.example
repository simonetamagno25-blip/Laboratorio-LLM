# Copiare in .env. In Docker LMSTUDIO_BASE_URL e SCADENZE_API_URL vengono sovrascritti da docker-compose.yml.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Identificativo restituito da GET /v1/models
LMSTUDIO_MODEL=google/gemma-4-e2b
FUSO_ORARIO_PREDEFINITO=Europe/Rome
MAX_PASSAGGI_STRUMENTI=3
LOG_LEVEL=INFO
# Servizio HTTP di giorni e scadenze (python -m scadenze_api)
SCADENZE_API_URL=http://localhost:8000
