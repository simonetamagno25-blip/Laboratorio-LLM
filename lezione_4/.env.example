# Copiare in .env. In Docker LMSTUDIO_BASE_URL e SCADENZE_API_URL vengono sovrascritti da docker-compose.yml.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Identificativo restituito da GET /v1/models
LMSTUDIO_MODEL=google/gemma-4-e2b
FUSO_ORARIO_PREDEFINITO=Europe/Rome
MAX_PASSAGGI_STRUMENTI=3
LOG_LEVEL=INFO
# Ambito dell'agente: il router rifiuta le domande che non vi rientrano (senza virgolette)
AMBITO_AGENTE=ora e date nei vari fusi orari; calcoli e conversioni tra unità di misura; giorni tra date e scadenze lavorative; materiale del laboratorio (schede, sensori, attuatori, cavi, alimentazione, strumenti di misura) con quantità e posizione; note personali dell'utente; spiegazioni sui temi del corso Deep Learning e LLM (reti neurali, LLM, agenti, LangGraph, MCP); saluti e domande sull'assistente stesso
# Servizio HTTP di giorni e scadenze (python -m scadenze_api)
SCADENZE_API_URL=http://localhost:8000
# Archivio SQLite delle note personali (in Docker viene sovrascritto da docker-compose.yml)
PERCORSO_DB_NOTE=note.sqlite3
