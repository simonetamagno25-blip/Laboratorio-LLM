# Copiare in .env. In Docker LMSTUDIO_BASE_URL e SCADENZE_API_URL vengono sovrascritti da docker-compose.yml.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Identificativo restituito da GET /v1/models
LMSTUDIO_MODEL=google/gemma-4-e2b
FUSO_ORARIO_PREDEFINITO=Europe/Rome
MAX_PASSAGGI_STRUMENTI=3
LOG_LEVEL=INFO
# Quante volte il revisore può rimandare una risposta all'agente (intero >= 1)
MAX_REVISIONI=2
# Riassunto della cronologia: oltre SOGLIA_RIASSUNTO messaggi si riassumono i turni vecchi,
# conservando almeno gli ultimi MESSAGGI_CONSERVATI (minore della soglia)
SOGLIA_RIASSUNTO=20
MESSAGGI_CONSERVATI=6
# Ambito dell'agente: il router rifiuta le domande che non vi rientrano (senza virgolette)
AMBITO_AGENTE=ora e date nei vari fusi orari; calcoli e conversioni tra unità di misura; giorni tra date e scadenze lavorative; materiale del laboratorio (schede, sensori, attuatori, cavi, alimentazione, strumenti di misura) con quantità e posizione; note personali dell'utente; spiegazioni sui temi del corso Deep Learning e LLM (reti neurali, LLM, agenti, LangGraph, MCP); saluti, presentazioni e domande sull'assistente stesso o sulla conversazione in corso
# Servizio HTTP di giorni e scadenze (python -m scadenze_api)
SCADENZE_API_URL=http://localhost:8000
# Archivio SQLite delle note personali (in Docker viene sovrascritto da docker-compose.yml)
PERCORSO_DB_NOTE=note.sqlite3
# PostgreSQL per Docker Compose (step 9): scegliere una password propria nel .env, che resta fuori da Git
POSTGRES_USER=laboratorio
POSTGRES_PASSWORD=cambia-questa-password
POSTGRES_DB=chat
